# Copy this file to `.env` and fill in real values.
# Everything prefixed with VITE_ is bundled into the PUBLIC website.
# Never put passwords, API secrets or private keys here.

# WhatsApp business number in international format, digits only (country code + number).
# Example format: 91XXXXXXXXXX  — leave blank until the real number is ready.
VITE_WHATSAPP_NUMBER=9985091823

# Public website address (no trailing slash), used for canonical URLs, Open Graph tags
# and sitemap.xml. Example format: https://www.your-domain.in
# If blank, the build skips sitemap.xml and canonical tags use the current browser origin.
VITE_SITE_URL=

# Optional public contact details (leave blank to hide).
# Instagram accepts a username (chinnithara_kids), @username or the full profile URL.
VITE_INSTAGRAM_HANDLE=https://www.instagram.com/chinnithara_kids?psln=YzEwZjNpOGFueGt1
VITE_CONTACT_EMAIL=chinnithara.kids@gmail.com
