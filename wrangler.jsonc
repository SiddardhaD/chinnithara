// Cloudflare Workers static-site config (used by `npx wrangler deploy`).
// Serves the Vite build in ./dist and sends every unknown path to index.html,
// so React Router can handle links like /products/muslin-zip-frock.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chinnithara",
  "compatibility_date": "2026-10-01",
  // Keep the free https://chinnithara.chinnithara-kids.workers.dev address switched on.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
